<?xml version="1.0"?>
<robot name="my_robot">

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.055" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://my_robot/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <!-- lift half height -->
      <origin xyz="0.025 -0.008 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.184 0.1"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= LEFT WHEEL ================= -->
  <link name="left_wheel">
    <visual>
      <origin rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="package://my_robot/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <!-- SAME rotation as visual -->
      <origin rpy="-1.57 0 0"/>
      <geometry>
        <cylinder radius="0.041" length="0.035"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= RIGHT WHEEL ================= -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://my_robot/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <!-- SAME rotation as visual -->
      <origin rpy="1.57 0 0"/>
      <geometry>
        <cylinder radius="0.041" length="0.035"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= LIDAR ================= -->
  <link name="laser">
    <visual>
      <origin xyz="0.057 -0.02 -0.031" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://my_robot/meshes/lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <!-- MATCH visual -->
      <origin xyz="-0.01 -0.0085 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= JOINTS ================= -->

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.03 0.105 0.04"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.03 -0.12 0.04"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.057 -0.02 0.15"/>
  </joint>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0"/>
  </joint>
</robot>
